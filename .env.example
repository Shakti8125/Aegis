# Copy to .env and fill in. .env is gitignored — never commit real values.

# Local Neo4j (docker-compose.yml) and the graph-engineer subagent's MCP server
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# LLM ops layer. Ollama is the default; Gemini is the swap-in for the demo build.
OLLAMA_HOST=http://localhost:11434
GEMINI_API_KEY=
